# Copy this file to a real credentials file and fill in your own values.
#
# IMPORTANT: the Dealroom key is issued per person for the hackathon and its
# terms forbid sharing it. Get your own from Dealroom rather than reusing
# someone else's.
#
# app/config.py looks for these two filenames, in this order:
#   1. dealroom-<your-name>.env   (whatever Dealroom's zip gave you)
#   2. .env
# Either works. Point ENV_FILE_CANDIDATES in app/config.py at a different
# name if yours differs.

DEALROOM_CLIENT_ID=your-dealroom-client-id
DEALROOM_CLIENT_SECRET=your-dealroom-client-secret

# Only needed for plain-English thesis parsing (/api/parse-thesis).
# Without it the app falls back to the three dropdowns and still runs.
ANTHROPIC_API_KEY=your-anthropic-api-key
